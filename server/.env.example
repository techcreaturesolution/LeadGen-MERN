NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/leadgen
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# --- Google (Gmail) sign-in ---
# OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
# Optional: restrict sign-in to these domains, e.g. gmail.com
ALLOWED_EMAIL_DOMAINS=
# Comma separated emails that become admins (manage ads, users)
ADMIN_EMAILS=
# Local testing only: shows an email-only login form (ignored when NODE_ENV=production)
DEV_LOGIN_ENABLED=false

# --- Email campaigns sent from the user's own Gmail (Connect Gmail) ---
# Same OAuth Web client as sign-in. Enable the Gmail API, add the gmail.send scope to the consent screen,
# and register GMAIL_REDIRECT_URI as an authorised redirect URI.
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/gmail/callback
# Encrypts stored Gmail refresh tokens (required in production), e.g. `openssl rand -hex 32`
TOKEN_ENCRYPTION_KEY=
# Public URL of this API, used for unsubscribe links
PUBLIC_API_URL=http://localhost:5000
# true = campaigns only run as test runs (nothing is sent)
EMAIL_DRY_RUN=false
GMAIL_DAILY_LIMIT=400
GMAIL_SEND_INTERVAL_MS=4000
CAMPAIGN_MAX_RECIPIENTS=2000

# --- Lead sources ---
# Google Maps: Places API (New) key. Without it SerpAPI google_maps is used, else OpenStreetMap.
GOOGLE_MAPS_API_KEY=
# LinkedIn / Instagram discovery uses Google search via SerpAPI or Programmable Search.
SERPAPI_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# Experimental: scrape Bing HTML when no search API key is set (often blocked / low quality)
ENABLE_FREE_SEARCH_FALLBACK=false
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.kumi.systems/api/interpreter
 
# --- AI agent (optional, rule-based agent is used without it) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google AdSense (user-facing pages only; never shown in Admin) ---
# Publisher ID from AdSense → Account → Account information, e.g. ca-pub-1234567890123456
ADSENSE_CLIENT_ID=
# Ad unit slot IDs from AdSense → Ads → By ad unit → Display ads
ADSENSE_SLOT_BANNER=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_INLINE=
ADSENSE_SLOT_RAIL=
# Adds data-adtest="on" so test impressions/clicks are not billed
ADSENSE_TEST_MODE=false
# Show demo ad creatives in slots that have no AdSense unit configured
ADSENSE_DEMO=true

# --- Mandatory video ad before search results (per search, non-admin users) ---
VIDEO_AD_REQUIRED=true
VIDEO_AD_SECONDS=30
VIDEO_AD_EXEMPT_ADMINS=true
# Keep playing video ads on the campaign page while emails send in the background
VIDEO_AD_DURING_CAMPAIGNS=true
# Optional Google Ad Manager / IMA VAST tag URL (https://pubads.g.doubleclick.net/gampad/ads?...).
# Leave empty to play admin-uploaded video ads (Admin -> Advertisements -> placement "Video") or the demo video.
VIDEO_AD_VAST_TAG=

# --- Data quality ---
# Drop emails whose domain has no MX record
EMAIL_MX_CHECK=true
# strict: only keep leads whose name/category/website confirm every keyword of the search
# balanced: also fill the report with "likely" matches (flagged in Excel)
LEAD_MATCH_MODE=strict

# --- Shared results & retention ---
# Searches and their leads are deleted for every user (admins included) this many days after they were run
DATA_RETENTION_DAYS=7
# Reuse leads found by any user's matching search (same business type, locations and sources) within the retention window
SHARED_LEAD_CACHE=true

# --- Limits ---
MAX_CONCURRENT_JOBS=2
CRAWL_CONCURRENCY=5
CRAWL_TIMEOUT_MS=10000
DAILY_SEARCH_LIMIT=25
