NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/leadgen
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# --- Google (Gmail) sign-in ---
# OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
# Optional: restrict sign-in to these domains, e.g. gmail.com
ALLOWED_EMAIL_DOMAINS=
# Comma separated emails that become admins (manage ads, users)
ADMIN_EMAILS=
# Local testing only: shows an email-only login form (ignored when NODE_ENV=production)
DEV_LOGIN_ENABLED=false

# --- Lead sources ---
# Google Maps: Places API (New) key. Without it SerpAPI google_maps is used, else OpenStreetMap.
GOOGLE_MAPS_API_KEY=
# LinkedIn / Instagram discovery uses Google search via SerpAPI or Programmable Search.
SERPAPI_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# Experimental: scrape Bing HTML when no search API key is set (often blocked / low quality)
ENABLE_FREE_SEARCH_FALLBACK=false
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# --- AI agent (optional, rule-based agent is used without it) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google AdSense (user-facing pages only; never shown in Admin) ---
# Publisher ID from AdSense → Account → Account information, e.g. ca-pub-1234567890123456
ADSENSE_CLIENT_ID=
# Ad unit slot IDs from AdSense → Ads → By ad unit → Display ads
ADSENSE_SLOT_BANNER=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_INLINE=
ADSENSE_SLOT_RAIL=
# Adds data-adtest="on" so test impressions/clicks are not billed
ADSENSE_TEST_MODE=false
# Show demo ad creatives in slots that have no AdSense unit configured
ADSENSE_DEMO=true
# 1-minute video ad before every job search result.
# VAST/VMAP ad tag from Google Ad Manager / AdSense for video, played with the Google IMA SDK.
# Google's public test tag:
# https://pubads.g.doubleclick.net/gampad/ads?iu=/21775744923/external/single_ad_samples&sz=640x480&cust_params=sample_ct%3Dlinear&ciu_szs=300x250%2C728x90&gdfp_req=1&output=vast&unviewed_position_start=1&env=vp&impl=s&correlator=
VIDEO_AD_TAG_URL=
# Minimum seconds the video ad gate stays open (house video ads / demo fill the rest)
VIDEO_AD_SECONDS=60

# --- Limits ---
MAX_CONCURRENT_JOBS=2
CRAWL_CONCURRENCY=5
CRAWL_TIMEOUT_MS=10000
DAILY_SEARCH_LIMIT=25
# Job search: per-user daily limit, jobs to enrich with contact details per search, time budget
DAILY_JOB_SEARCH_LIMIT=50
JOB_ENRICH_LIMIT=12
JOB_SEARCH_BUDGET_MS=40000
